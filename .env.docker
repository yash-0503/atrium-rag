# Configuration used by `docker compose`.
#
# This file is the container-side counterpart to your local `.env`:
# the hostnames differ (a container reaches services by service name,
# and the host machine by `host.docker.internal`), everything else is
# the same.
#
# `.env` on your machine is for running atrium directly (laptop, CI).
# This file is for `docker compose up`. Keep API_KEY empty here unless
# you are putting the stack behind a network you control.

# --- Vector database ------------------------------------------------------
# `qdrant` is the service name in docker-compose.yml. Use `pgvector`
# with the pgvector profile instead.
VECTOR_DB=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
PG_CONN=postgresql://user:pass@pgvector:5432/db

# --- Embedding provider ---------------------------------------------------
# Ollama runs on the host, not in the compose network.
# `host.docker.internal` resolves on Docker Desktop (macOS + Windows).
# On Linux, add `extra_hosts: ["host.docker.internal:host-gateway"]`
# to the api service, or point this at a reachable Ollama host.
EMBED_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=bge-large
EMBED_DIM=1024

# --- Optional features ----------------------------------------------------
OCR_ENABLED=0
OCR_PROVIDER=tesseract
OCR_LANG=eng
TESSERACT_CMD=

RERANK_ENABLED=0
RERANK_PROVIDER=bge
RERANK_MODEL=
RERANK_BACKEND=
RERANK_DEVICE=
RERANK_MAX_LENGTH=512
FLASHRANK_CACHE_DIR=
COHERE_API_KEY=

VISION_ENABLED=0
VISION_MODEL=minicpm-v4.6:1b
VISION_TIMEOUT_SECONDS=180

# --- Retrieval / server ---------------------------------------------------
DEFAULT_TOP_K=8
DENSE_CONFIDENT_GAP=0.05
DENSE_MIN_SCORE=0.55
LOG_LEVEL=INFO
# The job queue lives on the shared `atrium-data` volume so the API
# and every worker see the same file.
JOB_DB_PATH=/data/jobs.db
JOB_STALE_SECONDS=1800
INGEST_CONCURRENCY=4
WORKER_POLL_BASE=1.0
WORKER_POLL_MAX=10.0
WORKER_JOB_TIMEOUT=0
RETRIEVAL_LAB_MAX_SESSIONS=16

# --- Limits / security ----------------------------------------------------
MAX_UPLOAD_BYTES=104857600
ALLOWED_MIME_TYPES=
ALLOW_CHUNKED_UPLOADS=0
API_KEY=
CORS_ALLOW_ORIGINS=
