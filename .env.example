# atrium configuration template.
#
#   cp .env.example .env      # then edit
#   atrium init                # or let the wizard write it for you
#
# Every variable here is read by atrium/main.py, atrium/worker.py and
# the CLI. Lines starting with # are ignored; everything after a
# value's whitespace-# is a comment.
#
# Precedence: a real environment variable beats this file, and this
# file beats the built-in default. So `API_KEY=... uvicorn
# atrium.main:app` wins over whatever is written here.

# --- Vector database ------------------------------------------------------
# Choose one. Both backends implement the same retrieval protocol.
#   qdrant    — Qdrant
#   pgvector  — Postgres + pgvector
VECTOR_DB=sqlite

# Qdrant. Ignored unless VECTOR_DB=qdrant.
# Inside Docker Compose the hostname is the service name (`qdrant`);
# on a laptop it is `localhost`.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Postgres connection string. Ignored unless VECTOR_DB=pgvector.
# Format: postgresql://user:password@host:port/database
PG_CONN=postgresql://user:pass@pgvector:5432/db

# --- Embedding provider ---------------------------------------------------
# Any server that speaks the OpenAI /v1/embeddings API: Ollama, OpenAI,
# vLLM, LM Studio, TEI, Together. The base URL includes the /v1.
EMBED_BASE_URL=http://localhost:11434/v1

# The key for that endpoint. Blank for local servers; required by
# hosted providers.
EMBED_API_KEY=

# "http" for any OpenAI-compatible endpoint, "fastembed" for the
# in-process ONNX embedder from the `local` extra (no server, no key).
EMBED_PROVIDER=http

# Embedding model + dimension. Defaults match the published 19-set
# benchmark headline (bge-large / 1024). Override with care — promote
# embedder changes only after re-running the benchmark; see README.
EMBED_MODEL=bge-large
EMBED_DIM=1024

# --- Local vector store ----------------------------------------------------
# The SQLite file used when VECTOR_DB=sqlite. Nothing else is needed:
# no server, no Docker.
LOCAL_DB_PATH=atrium_local.db

# --- Vision (optional) ----------------------------------------------------
# VISION_ENABLED=1 captions image-only pages and diagrams with a
# vision model during parsing. Costs a lot of time on document-heavy
# corpora; off by default.
VISION_ENABLED=0
VISION_MODEL=minicpm-v4.6:1b
VISION_TIMEOUT_SECONDS=180

# --- OCR (optional) -------------------------------------------------------
# OCR_ENABLED=1 turns on OCR for scanned pages and image-only docs.
# Requires `pip install atrium[ocr]` and (for Tesseract) the
# Tesseract binary on PATH — see README.
OCR_ENABLED=0
OCR_PROVIDER=tesseract   # or rapidocr
OCR_LANG=eng
# Path to the Tesseract binary. Empty = look it up on PATH.
TESSERACT_CMD=

# --- Reranking (optional) -------------------------------------------------
# RERANK_ENABLED=1 turns on cross-encoder reranking for /search.
# Requires `pip install atrium[rerank]` (or [flashrank]).
RERANK_ENABLED=0
RERANK_PROVIDER=bge   # bge | flashrank | cohere
RERANK_MODEL=
RERANK_DEVICE=        # bge only: cpu | cuda | mps
RERANK_BACKEND=       # cohere | flashrank | bge-local
RERANK_MAX_LENGTH=512
FLASHRANK_CACHE_DIR=
COHERE_API_KEY=

# --- Retrieval ------------------------------------------------------------
# Default top-k for /search and `atrium search`. The v0.0.1 headline
# uses 8 — the top-k sweep on the 19-fixture benchmark showed k=8
# captures 5 more queries than k=5 for 1.6x the scoring cost.
DEFAULT_TOP_K=8

# Thresholds for the dense-confidence gate. The gate decides when the
# optional BM25 sparse ranker is consulted on top of the dense one.
# Raising either one makes the gate stricter (more BM25 consulted).
DENSE_CONFIDENT_GAP=0.05
DENSE_MIN_SCORE=0.55

# --- Server ---------------------------------------------------------------
# LOG_LEVEL=DEBUG|INFO|WARNING|ERROR
LOG_LEVEL=INFO

# Where the async-job queue lives. A single SQLite file, shared by the
# API and every worker. To run workers on other hosts, put this file on
# a shared volume (NFS, a mounted PVC) — there is no Postgres job store.
JOB_DB_PATH=jobs.db

# How long a job may sit in `running` before a worker hands it back to
# the queue (seconds). Set it above the slowest document you expect:
# a 500-page PDF can take minutes, and reclaiming it early means two
# workers ingest the same document.
JOB_STALE_SECONDS=1800

# How many documents may be ingested at once.
INGEST_CONCURRENCY=4

# Worker poll backoff (seconds) and per-job timeout. 0 = no timeout.
WORKER_POLL_BASE=1.0
WORKER_POLL_MAX=10.0
WORKER_JOB_TIMEOUT=0

# How many retrieval-lab sessions to keep in RAM.
RETRIEVAL_LAB_MAX_SESSIONS=16

# --- Limits ---------------------------------------------------------------
# Maximum upload size in bytes (default 100 MB). Uploads larger than
# this are rejected with 413 before being read into memory.
MAX_UPLOAD_BYTES=104857600

# Allowed MIME types for upload (comma-separated). Empty = allow any
# detected by the built-in format detector. Set explicitly in prod for
# tighter validation.
ALLOWED_MIME_TYPES=

# Accept uploads without a Content-Length header.
ALLOW_CHUNKED_UPLOADS=0

# --- API auth (optional) --------------------------------------------------
# Set API_KEY to require `Authorization: Bearer <key>` on all routes
# except /health. Empty = no auth (dev only).
API_KEY=

# --- CORS -----------------------------------------------------------------
# Comma-separated origin allowlist. Empty = same-origin only.
CORS_ALLOW_ORIGINS=
